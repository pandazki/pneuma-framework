# Copy to .env. Everything is optional.

# Build PneumaSpace from a local checkout instead of the pinned GitHub commit.
# A path to the checkout, not a git URL: compose.yaml appends /cli and /templates to it.
# PNEUMA_SPACE_CONTEXT=../../../pneuma-space

# Where the app directories live on this machine (default ./apps).
# PNEUMA_APPS_DIR=./apps

# personal: the standing policy approves low-risk changes, the owner decides risky ones.
# review-all: the owner decides every change.
# PNEUMA_GOVERNANCE=personal

# Skip booting each draft on PneumaSpace before release (faster, weaker gate).
# PNEUMA_PREVIEW=off

# PNEUMA_OWNER=user:me
# PNEUMA_SPACE_HTTP_PORT=8080
# PNEUMA_SPACE_ADMIN_PORT=8081
# PNEUMA_SPACE_OBJECT_PORT=9000
# PNEUMA_HOST_PORT=8090
