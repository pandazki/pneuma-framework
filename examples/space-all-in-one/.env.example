# Copy to .env. Everything is optional.

# Build PneumaSpace from a local checkout instead of the pinned GitHub commit.
# A path to the checkout, not a git URL: compose.yaml appends /cli and /templates to it.
# PNEUMA_SPACE_CONTEXT=../../../pneuma-space

# Where the app directories live on this machine (default ./apps).
# PNEUMA_APPS_DIR=./apps

# personal: the standing policy approves low-risk changes, the owner decides risky ones.
# review-all: the owner decides every change.
# PNEUMA_GOVERNANCE=personal

# The risk preset: which change carries which risk, and which risks the standing policy may approve.
# Host-driven runs (bun run drive) read this path on the machine. For the container it is a path
# inside the container, so mount your file there as well. Default: policy/personal.json.
# PNEUMA_POLICY_FILE=./policy/personal.json

# Skip booting each draft on PneumaSpace before release (faster, weaker gate).
# PNEUMA_PREVIEW=off

# Seconds a preview stands: it is an ephemeral app that ends itself, and a change waiting for the owner keeps it
# until then; approving is refused once it has ended, until `preview <change-id>` publishes it again. PneumaSpace
# refuses more than its ephemeral_max_ttl_seconds (default 3600; raise it with PUT /api/policy first).
# PNEUMA_PREVIEW_TTL=3600

# The name this Host goes by on PneumaSpace as the manager of the apps it releases (default pneuma-host).
# PNEUMA_MANAGER=pneuma-host

# Practice, not a promise: let undo put an app's stored data back (README, "Practice: declaring that
# stored data can be put back"). Needs `docker compose --profile postgres up -d` and apps on PostgreSQL
# (PneumaSpace's global policy db_backend=postgres before an app first declares a database). The URL is
# superuser access to every app's database: one trusted machine only.
# PNEUMA_DATA_SNAPSHOT=postgres-template
# PNEUMA_DATA_SNAPSHOT_URL=postgresql://postgres:pneuma-local@postgres:5432/postgres

# PNEUMA_OWNER=user:me

# Pictures of apps on the owner page come from the screenshot service (compose.yaml). Empty turns them off:
# the page shows placeholders, and nothing else changes. Hours before a live version is pictured again (default 24).
# PNEUMA_SCREENSHOT_CDP=
# PNEUMA_SCREENSHOT_REFRESH_HOURS=24

# Running beside other services, or a second stack (README, "Running beside other services"):
# the four ports on 127.0.0.1, the Docker network's name, the compose project name and the apps directory.
# COMPOSE_PROJECT_NAME=pneuma-all-in-one
# PNEUMA_SPACE_NETWORK=pneuma-all-in-one
# PNEUMA_SPACE_HTTP_PORT=8080
# PNEUMA_SPACE_ADMIN_PORT=8081
# PNEUMA_SPACE_OBJECT_PORT=9000
# The Host's port on this machine. The Host records its address in .pneuma/host.json of the apps
# directory and of every app, so the CLI there finds it without PNEUMA_HOST.
# PNEUMA_HOST_PORT=8090
