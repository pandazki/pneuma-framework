{
  "name": "space-all-in-one",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A headless Creation Host on PneumaSpace: one governed loop, driven either by a coding agent (Claude Code, Codex) or by the Host.",
  "scripts": {
    "serve": "bun run src/serve.ts",
    "drive": "bun run src/drive.ts",
    "dev:page": "bun run test/page-dev.ts",
    "build:page": "bun run web/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pneuma-framework/backend-claude-code": "workspace:*",
    "@pneuma-framework/backend-codex": "workspace:*",
    "@pneuma-framework/core": "workspace:*",
    "@pneuma-framework/host-kit": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadow-plugin": "2.1.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.6.0"
  }
}
