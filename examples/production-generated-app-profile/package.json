{
  "name": "@pneuma-framework/example-production-generated-app-profile",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "bun run src/server/local.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/*.test.ts",
    "verify": "bun run typecheck && bun run test && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "neon:smoke": "bun run src/db/neon-smoke.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@neondatabase/serverless": "^1.0.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.7",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0"
  }
}
